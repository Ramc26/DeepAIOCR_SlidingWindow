# OpenRouter (default) or any OpenAI-compatible chat-completions endpoint.
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare Workers AI (OpenAI-compatible): uncomment and set account ID in the URL.
# OPENROUTER_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
# OPENROUTER_API_KEY=your_cloudflare_api_token
# OPENROUTER_MODEL=@cf/meta/llama-3.1-8b-instruct

REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=2
MAX_PAGE_CHARS=12000
LOG_LEVEL=INFO
